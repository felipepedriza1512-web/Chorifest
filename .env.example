# ==============================================================================
# CHORIFEST - ARCHIVO DE CONFIGURACION DE ENTORNO
# ==============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" en la raiz del proyecto en el servidor.
#   2. Completa cada variable con los valores reales de TU hosting.
#   3. NUNCA subas el archivo ".env" a git ni lo hagas publico por URL.
#   4. Este archivo ".env.example" NO contiene datos reales: es seguro versionarlo.
# ==============================================================================

# ---- BASE DE DATOS ----
DB_HOST=sql204.infinityfree.com
DB_PORT=3306
DB_USER=if0_XXXXXXXX
DB_PASS=TU_CONTRASENA_SEGURA_AQUI
DB_NAME=if0_XXXXXXXX_chorifest

# ---- ENTORNO ----
# "production" o "development"
APP_ENV=production

# ---- ZONA HORARIA ----
APP_TIMEZONE=America/Bogota

# ---- LOGGING ----
# Ruta absoluta al log de PHP (fuera del directorio public/).
# Ejemplo InfinityFree/cPanel: /home/usuario/logs/chorifest_errors.log
PHP_ERROR_LOG=/home/tu_usuario/logs/chorifest_errors.log

# ---- URL BASE ----
# Sin barra final. Ej: https://chorifest.epizy.com
APP_URL=https://TU_DOMINIO_AQUI

# ---- SMTP (opcional, para recuperacion de contrasena) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=TU_APP_PASSWORD
MAIL_FROM=noreply@chorifest.com
